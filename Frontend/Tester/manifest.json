{
  "manifest_version": 3,
  "name": "Website Detector",
  "version": "1.0",
  "description": "Detects errors on websites.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Tester/content.js"]
    }
  ]
}
